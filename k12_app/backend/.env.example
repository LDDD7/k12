# K12 用户画像推荐系统 — 环境变量配置模板
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# ⚠️ .env 含密钥，已被 .gitignore 排除，切勿提交

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=k12_agent_db
DB_USER=k12
DB_PASSWORD=请填写数据库密码

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 大模型配置
# 对话/生成模型：DeepSeek
DEEPSEEK_API_KEY=请填写DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 向量模型（Embedding）：阿里云 DashScope text-embedding-v3（DeepSeek 无 Embedding 服务）
DASHSCOPE_API_KEY=请填写DashScope密钥

# 企业微信（本项目为开发/演示用途，默认 Mock 模式）
USE_MOCK=true

# JWT 配置（生产环境请使用强随机值）
JWT_SECRET_KEY=请填写随机字符串（可用 scripts/jwt_generate_secret_env.py 生成）
JWT_EXPIRE_MINUTES=30
